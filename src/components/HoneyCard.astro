---
import Picture from './Picture.astro';
import Icons from './Icons.astro';
import PriceBadge from './PriceBadge.astro';
import { priceFrom } from '../lib/price';
import { prezzoSuRichiesta } from '../data/bee-products';

interface Props {
  honey: any;
  eager?: boolean;
}
const { honey, eager = false } = Astro.props;
const href = `/miele/${honey.slug}/`;
// Come le card dei prodotti dell'alveare: se il prezzo non è pubblicato la
// pastiglia non sparisce, dice "Prezzo su richiesta" (il miele in favo non ha
// ancora un prezzo: vedi `priceFormats` vuoto in site.js).
const price = priceFrom(honey.priceFormats) ?? prezzoSuRichiesta;
---

<a class="honey-card" href={href}>
  <div class="honey-card-media">
    <Picture
      base={honey.cardImage ?? honey.image}
      alt={`${honey.name} — Bio & Golosità, Cassano d'Adda`}
      sizes="(min-width: 900px) 30vw, 100vw"
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : 'auto'}
      objectPosition={honey.imgPos}
      zoomable={false}
      class=""
    />
    <PriceBadge value={price} />
  </div>
  <div class="honey-card-body">
    <h3>{honey.name}</h3>
    <p>{honey.characteristics[1]}</p>
    <span class="card-link">
      Scopri e ordina il miele
      <Icons name="arrow" size={18} />
    </span>
  </div>
</a>
