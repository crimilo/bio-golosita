---
import Picture from './Picture.astro';
import VideoFigure from './VideoFigure.astro';

/**
 * La galleria della home è **un'unica sequenza**, non due liste (prima le foto,
 * poi i video): l'ordine è quello della frase dell'intro — «guarda le api al
 * lavoro, la smielatura e i barattoli pronti da portare a casa» — quindi i video
 * degli apiari stanno in mezzo alle foto e l'ultimo posto è dei barattoli
 * preparati. La lightbox compone la galleria in ordine di DOM
 * (`Lightbox.astro`), quindi sfoglia la stessa sequenza.
 *
 * Le classi seguono l'aspetto della sorgente: foto quadrate `g-item--square`,
 * verticali `g-item--tall`, video orizzontali `video-item--wide`, verticali
 * `video-item--tall`. I blocchi hanno la forma di quelli di `ProseBlocks`
 * (`{ photo }` / `{ video }`) e si distinguono con `'video' in m`, come là.
 */

/** Una voce della galleria: una foto o un video, mai entrambi. */
type MediaItem =
  | { photo: { base: string; cls: string; alt: string } }
  | { video: { src: string; poster: string; label: string; cls: string } };

const media: MediaItem[] = [
  // 1. le api al lavoro
  {
    photo: {
      base: 'api_che_producono',
      cls: 'g-item--square',
      alt: 'Api che producono il miele — Bio & Golosità, apiari nel Parco Adda Nord e in Alta Val Brembana',
    },
  },
  { photo: { base: 'apiario', cls: 'g-item--tall', alt: 'Apiario di Bio & Golosità, nel Parco Adda Nord e in Alta Val Brembana' } },
  { photo: { base: 'api', cls: 'g-item--tall', alt: 'Le api di Bio & Golosità in apiario, nel Parco Adda Nord e in Alta Val Brembana' } },
  {
    video: {
      src: '/video/api-che-producono-il-miele.mp4',
      poster: '/video/api-che-producono-il-miele-poster-a687f38c.avif',
      label: 'Le api che producono il miele, sui telai',
      cls: 'video-item--tall',
    },
  },
  // 2. la smielatura
  {
    video: {
      src: '/video/smielatura.mp4',
      poster: '/video/smielatura-poster-2c769c8a.avif',
      label: 'La smielatura del nostro miele',
      cls: 'video-item--wide',
    },
  },
  // 3. i barattoli pronti da portare a casa: la sorgente è verticale quasi 3:4
  // (1094×1479), l'aspetto di `g-item--tall` (3/4), quindi il ritaglio di
  // `object-fit: cover` è di pochi pixel. Al posto del vecchio ritratto
  // `raffaele`, che è stato ritirato.
  {
    photo: {
      base: 'raffaele_con_mieli_pronti_da_spedire',
      cls: 'g-item--tall',
      alt: 'Raffaele Antoci con i barattoli di miele preparati per gli ordini dei clienti',
    },
  },
];
---

<section class="section" id="galleria" aria-labelledby="gallery-title">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">dall'apiario alla tua tavola</span>
      <h2 id="gallery-title">Foto e video dei nostri apiari</h2>
      <p>
        Il nostro miele si vede: guarda le api al lavoro, la smielatura e i
        barattoli pronti da portare a casa.
      </p>
    </div>

    <div class="gallery-grid gallery-grid--three">
      {/* Galleria della home: griglia a piena larghezza (1056px) e 3 colonne,
          quindi colonne da 336px. Con 2 colonne piene i media diventavano
          enormi (516x688); con la griglia stretta a 860px la sezione restava
          rientrata rispetto alle altre. Sotto i 700px `gallery-grid--three`
          torna a 2 colonne. */}
      {
        media.map((m) =>
          'video' in m ? (
            <VideoFigure src={m.video.src} poster={m.video.poster} label={m.video.label} cls={m.video.cls} />
          ) : (
            <figure class={`g-item ${m.photo.cls}`} style="margin:0;">
              <Picture
                base={m.photo.base}
                alt={m.photo.alt}
                sizes="(min-width: 1120px) 336px, (min-width: 900px) 30vw, 50vw"
              />
            </figure>
          )
        )
      }
    </div>
  </div>
</section>
