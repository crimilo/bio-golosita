---
import Picture from './Picture.astro';
import VideoFigure from './VideoFigure.astro';

const videos = [
  {
    src: '/video/smielatura.mp4',
    poster: '/video/smielatura-poster-2c769c8a.avif',
    label: 'La smielatura del nostro miele',
    cls: 'video-item--wide',
  },
  {
    src: '/video/api-che-producono.mp4',
    poster: '/video/api-che-producono-poster-2fd11576.avif',
    label: 'Le api al lavoro negli apiari',
    cls: 'video-item--wide',
  },
  {
    src: '/video/due-api-regina.mp4',
    poster: '/video/due-api-regina-poster-35fa49f1.avif',
    label: 'Due api regine a confronto',
    cls: 'video-item--wide',
  },
  {
    src: '/video/api-che-producono-il-miele.mp4',
    poster: '/video/api-che-producono-il-miele-poster-a687f38c.avif',
    label: 'Le api che producono il miele, sui telai',
    cls: 'video-item--tall',
  },
];

const photos = [
  { base: 'api_che_producono', cls: 'g-item--square', alt: 'Api che producono il miele — Bio & Golosità Cassano d\'Adda' },
  { base: 'apiario', cls: 'g-item--tall', alt: 'Apiario di Bio & Golosità a Cassano d\'Adda (MI)' },
  { base: 'api', cls: 'g-item--tall', alt: 'Le api di Bio & Golosità, miele della Martesana' },
  { base: 'raffaele', cls: 'g-item--square', alt: 'Raffaele Antoci, apicoltore di Bio & Golosità a Cassano d\'Adda' },
];
---

<section class="section" id="galleria" aria-labelledby="gallery-title">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">dall'apiario alla tua tavola</span>
      <h2 id="gallery-title">Foto e video dei nostri apiari</h2>
      <p>
        Il nostro miele si vede: guarda le api al lavoro, la smielatura e i
        barattoli pronti da portare a casa.
      </p>
    </div>

    <div class="gallery-grid">
      {
        photos.map((p) => (
          <figure class={`g-item ${p.cls}`} style="margin:0;">
            <Picture base={p.base} alt={p.alt} sizes="(min-width:900px) 33vw, 50vw" />
          </figure>
        ))
      }

      {
        videos.map((v) => (
          <VideoFigure src={v.src} poster={v.poster} label={v.label} cls={v.cls} link={v.link} />
        ))
      }
    </div>
  </div>
</section>
