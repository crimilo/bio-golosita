---
import ProseFigure from './ProseFigure.astro';
import VideoFigure from './VideoFigure.astro';
import type { Block } from '../lib/types';

interface Props {
  blocks: Block[];
}

const { blocks } = Astro.props;
---

{
  blocks.map((b) => {
    if ('eyebrow' in b) return <span class="eyebrow">{b.eyebrow}</span>;
    if ('h2' in b) return <h2 id={b.id}>{b.h2}</h2>;
    if ('h3' in b) return <h3>{b.h3}</h3>;
    if ('p' in b) return <p set:html={b.p} />;
    if ('note' in b) return <p class="disclaimer" set:html={b.note} />;
    if ('ul' in b) {
      return (
        <ul>
          {b.ul.map((li) => (
            // il testo va in uno <span>: dentro .prose i li sono flex, e il testo
            // "sciolto" gonfia la larghezza minima mandando in overflow la griglia
            <li>
              <span set:html={li} />
            </li>
          ))}
        </ul>
      );
    }
    if ('img' in b) {
      return (
        <ProseFigure
          base={b.img.base}
          alt={b.img.alt}
          caption={b.img.caption}
          sizes="(min-width: 900px) 46rem, 100vw"
        />
      );
    }
    if ('table' in b) {
      // Confronto a colonne: `data-label` (il nome della colonna) è ciò che la
      // cella mostra come etichetta quando sotto i 640px il tr diventa una
      // scheda, perché lì l'<thead> è nascosto.
      return (
        <div class="table-wrap">
          <table class="data-table">
            <thead>
              <tr>
                <th scope="col">
                  <span class="sr-only">Caratteristica</span>
                </th>
                {b.table.head.map((col) => (
                  <th scope="col">{col}</th>
                ))}
              </tr>
            </thead>
            <tbody>
              {b.table.rows.map((row) => (
                <tr>
                  <th scope="row">{row.label}</th>
                  {row.cells.map((cell, i) => (
                    <td data-label={b.table.head[i]} set:html={cell} />
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      );
    }
    if ('video' in b) {
      // Video dentro il testo. Con il default verticale, la colonna stretta di
      // `.prose-video` gli fa mantenere l'aspetto 9/16 (`.video-item--tall`),
      // senza ritagli; un video orizzontale (`video-item--wide`) prende invece
      // tutta la colonna di lettura (`.prose-video--wide`).
      // Il poster si carica solo avvicinandosi al viewport (VideoFigure.astro).
      const cls = b.video.cls ?? 'video-item--tall';
      return (
        <div class={`prose-video${cls === 'video-item--wide' ? ' prose-video--wide' : ''}`}>
          <VideoFigure
            src={b.video.src}
            poster={b.video.poster}
            label={b.video.label}
            cls={cls}
          />
        </div>
      );
    }
    if ('row' in b) {
      // Testo e foto sulla stessa riga: da desktop la foto sta a fianco del
      // testo, sotto i 900px va sotto (vedi `.prose-row` in global.css).
      return (
        <div class="prose-row">
          <div class="prose-row-text">
            <Astro.self blocks={b.row.text} />
          </div>
          <ProseFigure
            base={b.row.img.base}
            alt={b.row.img.alt}
            caption={b.row.img.caption}
            sizes="(min-width: 900px) 19rem, 100vw"
          />
        </div>
      );
    }
    if ('cta' in b) {
      return (
        <p class="mt-2">
          <a class="btn btn-primary" href={b.cta.href}>
            {b.cta.label}
          </a>
        </p>
      );
    }
    return null;
  })
}
