---
import Icons from './Icons.astro';
import { site } from '../data/site';

// Indicazioni stradali verso il pin della scheda Google Maps
const directionsUrl = `https://www.google.com/maps/dir/?api=1&destination=${site.address.geo.lat},${site.address.geo.lng}`;
---

<section class="section" id="contatti" aria-labelledby="contatti-title">
  <div class="container">
    <div class="section-head center" style="margin-inline:auto;">
      <span class="eyebrow">siamo a due passi da te</span>
      <h2 id="contatti-title">Contattaci: il miele è pronto</h2>
      <p>
        Ordina in pochi secondi: una chiamata o un messaggio WhatsApp e il tuo
        miele di Cassano d'Adda è tuo.
      </p>
    </div>

    <div class="contact-card contact-card--wide">
      <a class="contact-row contact-row--link" href={site.phoneHref}>
        <Icons name="phone" size={22} />
        <div>
          <h3>Telefono</h3>
          <p>{site.phoneDisplay}</p>
        </div>
      </a>
      <a class="contact-row contact-row--link" href={site.whatsapp} target="_blank" rel="noopener">
        <Icons name="whatsapp" size={22} />
        <div>
          <h3>WhatsApp</h3>
          <p>Scrivici: ti rispondiamo appena possibile</p>
        </div>
      </a>
      {site.socials.map((s) => (
        <a class="contact-row contact-row--link" href={s.url} target="_blank" rel="noopener">
          <Icons name={s.name.toLowerCase()} size={22} />
          <div>
            <h3>{s.name}</h3>
            <p>{s.handle}</p>
          </div>
        </a>
      ))}
      <a class="contact-row contact-row--link" href={site.googleMapsUrl} target="_blank" rel="noopener">
        <Icons name="pin" size={22} />
        <div>
          <h3>Dove siamo</h3>
          <p>
            {site.address.street} — {site.address.zip} {site.address.city} ({site.address.province})
          </p>
        </div>
      </a>
      <div class="contact-row">
        <Icons name="clock" size={22} />
        <div>
          <h3>Orari</h3>
          <p>{site.hours}</p>
        </div>
      </div>
      <div class="contact-row">
        <Icons name="info" size={22} />
        <div>
          <h3>Ritiro e consegna</h3>
          <p>
            Consegna a domicilio a Cassano d'Adda e in tutta la zona tra
            Milano, Bergamo e Cremona: Fara Gera d'Adda, Trezzo sull'Adda, Vaprio
            d'Adda, il Parco Nord Milano, Treviglio, Gorgonzola, Melzo, Rivolta
            d'Adda, Caravaggio e dintorni. La consegna può essere gratuita:
            dipende dall'ordine e da dove mi trovo quando mi chiami, quindi
            chiama e ti confermo subito. In alternativa, ritiro in sede su
            appuntamento: chiama o scrivi prima di passare, spesso siamo in
            apiario.
          </p>
        </div>
      </div>
    </div>

    <div class="map-card">
      <iframe
        src={site.googleMapsEmbedUrl}
        height="340"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        title="Mappa: scheda Google Maps di Bio & Golosità — Apicoltura e Vendita Miele, Via Salvo D'Acquisto 9, Cassano d'Adda (MI)"
        allowfullscreen
      ></iframe>
      <div class="map-actions">
        <a class="btn btn-primary" href={site.googleMapsUrl} target="_blank" rel="noopener">
          <Icons name="pin" size={18} />
          Apri la scheda su Google Maps
        </a>
        <a class="btn btn-ghost" href={directionsUrl} target="_blank" rel="noopener">
          <Icons name="arrow" size={18} />
          Indicazioni stradali
        </a>
      </div>
    </div>
  </div>
</section>
