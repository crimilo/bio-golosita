---
// Inline SVG icons (stroke = currentColor)
interface Props {
  name: 'phone' | 'whatsapp' | 'pin' | 'clock' | 'arrow' | 'check' | 'star' | 'play' | 'info' | 'leaf' | 'home' | 'package' | 'shield' | 'sparkle';
  size?: number;
}
const { name, size = 24 } = Astro.props;
const icons = {
