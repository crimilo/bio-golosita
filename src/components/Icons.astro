  whatsapp:
    '<path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M9 9.5c.5-1 1.5-1 2-.5l1 1 2-2c.5-.5 1-.5 1.5 0 .4.4.4 1 0 1.4l-2 2c-.4.4-.4 1 0 1.4.4.4 1 .4 1.4 0 .5-.5 1.2-.4 1.5.3" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>',
