---
import { imgSrcset, imgUrl, largestWidth, imgDims } from '../lib/images.js';

interface Props {
  base: string;
  alt: string;
  sizes?: string;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  class?: string;
  zoomable?: boolean;
  width?: number;
  height?: number;
  objectPosition?: string;
}

const {
  base,
  alt,
  sizes = '100vw',
  loading = 'lazy',
  fetchpriority = 'auto',
  zoomable = true,
  width,
  height,
  objectPosition,
} = Astro.props;

const largest = largestWidth(base);
const dims = imgDims(base);
const imgW = width ?? dims.width;
const imgH = height ?? dims.height;
const cls = `${Astro.props.class ?? ''} ${zoomable ? 'lightbox-target' : ''}`.trim();
---

<picture>
  {/* Unico formato: AVIF (l'immagine è già generata solo in AVIF, vedi
      scripts/process-images.mjs). */}
  <source type="image/avif" srcset={imgSrcset(base)} sizes={sizes} />
  <img
    src={imgUrl(base)}
    srcset={imgSrcset(base)}
    sizes={sizes}
    width={imgW}
    height={imgH}
    alt={alt}
    loading={loading}
    decoding="async"
    fetchpriority={fetchpriority}
    class={cls || undefined}
    data-full={imgUrl(base, { width: largest })}
    style={objectPosition ? `object-position: ${objectPosition}` : undefined}
  />
</picture>
