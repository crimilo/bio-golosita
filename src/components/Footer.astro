---
import Logo from './Logo.astro';
import Icons from './Icons.astro';
import { site } from '../data/site';
---

<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <Logo />
        <p class="mt-2" style="max-width: 30rem;">
          {site.tagline}. {site.legalName}: miele di api proprie, non pastorizzato,
          raccolto nelle campagne della Martesana e della Gera d'Adda.
        </p>
        <ul class="footer-socials" aria-label="Seguici sui social">
          {site.socials.map((s) => (
            <li>
              <a href={s.url} target="_blank" rel="noopener" aria-label={`Seguici su ${s.name}`} title={`Seguici su ${s.name}`}>
                <Icons name={s.name.toLowerCase()} size={18} />
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h2 class="footer-heading">I nostri mieli</h2>
        <ul>
          {site.honeys.map((h) => (
            <li><a href={`/miele/${h.slug}/`}>{h.name}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h2 class="footer-heading">Contatti</h2>
        <ul>
          <li>
            <a href={site.phoneHref}>{site.phoneDisplay}</a>
          </li>
          <li>
            <a href={site.whatsapp} rel="noopener" target="_blank">WhatsApp</a>
          </li>
          <li>
            <a href="/contatti/">Pagina contatti</a>
          </li>
        </ul>
      </div>

      <div>
        <h2 class="footer-heading">Sede</h2>
        <address>
          {site.legalName}
          <br />
          {site.address.street}
          <br />
          {site.address.zip} {site.address.city} ({site.address.province})
          <br />
          {site.address.region}, {site.address.country}
          <br />
          P. IVA {site.vatId}
          <br />
          REA MI-{site.rea}
        </address>
      </div>
    </div>

    <div class="footer-bottom">
      <span>© {new Date().getFullYear()} Bio & Golosità · Antoci Raffaele · Tutti i diritti riservati</span>
      <span>
        Miele prodotto e confezionato con api proprie · {site.experienceYears} anni di esperienza
      </span>
    </div>
  </div>
</footer>
