---
import Logo from './Logo.astro';
import Icons from './Icons.astro';
import { site } from '../data/site';

/** Solo le voci principali: le varianti di millefiori restano raggiungibili
 *  dalla pagina /miele/miele-millefiori/ (vedi spec footer). */
const honeyLinks = [
  { href: '/miele/', label: 'Tutti i mieli' },
  { href: '/miele/miele-di-acacia/', label: 'Miele di Acacia' },
  { href: '/miele/miele-millefiori/', label: 'Miele Millefiori' },
  { href: '/miele/miele-di-castagno/', label: 'Miele di Castagno' },
  { href: '/miele/miele-in-favo/', label: 'Miele in Favo' },
];

const productLinks = [
  { href: '/polline-d-api/', label: "Polline d'api" },
  { href: '/api-regine/', label: 'Api regine' },
  { href: '/nuclei-api/', label: "Nuclei d'api" },
  { href: '/consegna-miele/', label: 'Consegna miele' },
];

const infoLinks = [
  { href: '/guide/', label: 'Guide' },
  { href: '/chi-siamo/', label: 'Chi siamo' },
  { href: '/contatti/', label: 'Contatti' },
];
---

<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <Logo />
        <p class="mt-2" style="max-width: 30rem;">
          Bio &amp; Golosità è un'azienda agricola e apistica di Cassano d'Adda.
          Produciamo miele artigianale 100% italiano dalle nostre api, con
          vendita diretta e consegna nelle zone servite.
        </p>
        <ul class="footer-socials" aria-label="Seguici sui social">
          {site.socials.map((s) => (
            <li>
              <a href={s.url} target="_blank" rel="noopener" aria-label={`Seguici su ${s.name}`} title={`Seguici su ${s.name}`}>
                <Icons name={s.name.toLowerCase()} size={18} />
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h2 class="footer-heading">I nostri mieli</h2>
        <ul>
          {honeyLinks.map((l) => (
            <li><a href={l.href}>{l.label}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h2 class="footer-heading">Prodotti dell'apicoltura</h2>
        <ul>
          {productLinks.map((l) => (
            <li><a href={l.href}>{l.label}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h2 class="footer-heading">Contatti e info</h2>
        <ul>
          <li>
            <a href={site.phoneHref}>{site.phoneDisplay}</a>
          </li>
          <li>
            <a href={site.whatsapp} rel="noopener" target="_blank">WhatsApp</a>
          </li>
          {infoLinks.map((l) => (
            <li><a href={l.href}>{l.label}</a></li>
          ))}
        </ul>
        <address class="mt-2">
          {site.address.street}
          <br />
          {site.address.zip} {site.address.city} ({site.address.province})
          <br />
          {site.hours}
          <br />
          P. IVA {site.vatId} · REA MI-{site.rea}
        </address>
      </div>
    </div>

    <div class="footer-bottom">
      <span>© {new Date().getFullYear()} Bio & Golosità · Antoci Raffaele · Tutti i diritti riservati</span>
      <span>
        Miele prodotto e confezionato con api proprie · Apicoltore dal{' '}
        {site.apicoltoreDal}
      </span>
    </div>
  </div>
</footer>
