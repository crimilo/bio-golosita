---
import Logo from './Logo.astro';
import Icons from './Icons.astro';
import { site, nav } from '../data/site';

interface Props {
  pathname: string;
}
const { pathname } = Astro.props;
const ctaHref = pathname === '/' ? '/#contatti' : '/contatti';
---

<header class="header">
  <div class="header-inner">
    <Logo />
    <nav class="nav" aria-label="Navigazione principale">
      {
        nav.map((item) => (
          <a
            href={item.href}
            aria-current={pathname === item.href || (item.href !== '/' && pathname.startsWith(item.href.split('#')[0])) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
    <a class="btn btn-primary header-cta" href={ctaHref}>
      <Icons name="phone" size={18} />
      Contattaci
    </a>
  </div>
</header>
