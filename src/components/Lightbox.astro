---
// Lightbox globale: tap per zoom full-screen, tap per de-zoom.
---
<div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Anteprima immagine">
  <img src="" alt="" width="1200" height="900" />
  <button class="lightbox-close" type="button" aria-label="Chiudi">✕</button>
  <p class="lightbox-hint">Tocca l'immagine per ingrandire · tocca di nuovo per ridurre</p>
</div>

<script>
  const lb = document.getElementById('lightbox');
  const lbImg = lb.querySelector('img');
  const closeBtn = lb.querySelector('.lightbox-close');

  const open = (img) => {
    lbImg.removeAttribute('width');
    lbImg.removeAttribute('height');
    lbImg.style.maxWidth = '';
    lbImg.src = img.dataset.full || img.currentSrc || img.src;
    lbImg.alt = img.alt || '';
    lbImg.classList.remove('zoomed');
    // non ingrandire mai oltre la risoluzione reale dell'immagine
    lbImg.onload = () => {
      // mai oltre la risoluzione reale, MA mai oltre il contenitore (100%)
      // né il cap 1200px: il padding del lightbox resta così simmetrico
      // (niente vw: su desktop vw include lo scrollbar e sbilancia i bordi)
      if (lbImg.naturalWidth > 0)
        lbImg.style.maxWidth = `min(${lbImg.naturalWidth}px, 100%, 1200px)`;
    };
    lb.setAttribute('open', '');
    document.body.style.overflow = 'hidden';
    // nasconde anche lo scrollbar del viewport (html): senza, l'immagine
    // centrata risulta con meno padding a destra che a sinistra
    document.documentElement.style.overflow = 'hidden';
    closeBtn.focus();
  };
  const close = () => {
    lb.removeAttribute('open');
    lbImg.classList.remove('zoomed');
    lbImg.style.transformOrigin = '';
    document.body.style.overflow = '';
    document.documentElement.style.overflow = '';
  };

  document.addEventListener('click', (e) => {
    const t = e.target.closest('.lightbox-target');
    if (t && t.tagName === 'IMG') {
      e.preventDefault();
      open(t);
    } else if (e.target === lb || e.target === closeBtn) {
      close();
    }
  });

  lbImg.addEventListener('click', (e) => {
    if (lbImg.classList.contains('zoomed')) {
      // secondo tocco: riduci
      lbImg.classList.remove('zoomed');
      return;
    }
    // primo tocco: ingrandisci a partire dal punto toccato, non dal centro
    const rect = lbImg.getBoundingClientRect();
    const x = rect.width > 0 ? ((e.clientX - rect.left) / rect.width) * 100 : 50;
    const y = rect.height > 0 ? ((e.clientY - rect.top) / rect.height) * 100 : 50;
    lbImg.style.transformOrigin = `${x}% ${y}%`;
    lbImg.classList.add('zoomed');
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && lb.hasAttribute('open')) close();
  });
</script>
