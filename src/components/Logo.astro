---
interface Props {
  markOnly?: boolean;
}
const { markOnly = false } = Astro.props;
const mark = `<svg class="logo-mark" viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
  <defs>
    <linearGradient id="lg" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#f2a900"/>
      <stop offset="1" stop-color="#c97b00"/>
    </linearGradient>
  </defs>
  <path d="M32 3 57.2 17.5v29L32 61 6.8 46.5v-29Z" fill="url(#lg)" stroke="#8a5a00" stroke-width="2.5" stroke-linejoin="round"/>
  <path d="M32 14.5c7.6 10.8 12.8 15.9 12.8 23.1a12.8 12.8 0 1 1-25.6 0c0-7.2 5.2-12.3 12.8-23.1Z" fill="#fff6e0"/>
  <circle cx="27" cy="36" r="3.2" fill="#f7e3b0"/>
</svg>`;
---
{
  markOnly ? (
    <Fragment set:html={mark} />
  ) : (
    <a class="logo" href="/" aria-label="Bio e Golosità — miele dal 2021, home">
      <span set:html={mark} />
      <span class="logo-text">
        Bio e Golosità
        <small>miele dal 2021</small>
      </span>
    </a>
  )
}
