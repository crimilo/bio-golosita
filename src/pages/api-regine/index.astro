---
/**
 * /api-regine/ — scheda prodotto con la **stessa struttura delle schede miele**
 * (`miele/[slug].astro`): hero corta, blocco prodotto (foto, prezzo, voto,
 * caratteristiche, CTA), "Come alleviamo le nostre regine" (paragrafi + quattro
 * dati), i video, recensioni del prodotto, FAQ, "scopri anche" e chiusura
 * compatta.
 *
 * Quello che prima stava in tre posti diversi — scheda tecnica, paragrafi e
 * punti di forza — adesso vive in un posto solo: l'origine, il blocco prodotto e
 * le FAQ. I testi delle sezioni arrivano da `apiRegine` (`origine.notes`,
 * `origine.items`, `chips`, `note`).
 */
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Picture from '../../components/Picture.astro';
import Price from '../../components/Price.astro';
import PhotoGallery from '../../components/PhotoGallery.astro';
import Faq from '../../components/Faq.astro';
import CtaBand from '../../components/CtaBand.astro';
import LinkCards from '../../components/LinkCards.astro';
import Stars from '../../components/Stars.astro';
import Icons from '../../components/Icons.astro';
import PhoneCta from '../../components/PhoneCta.astro';
import { apiRegine, repartoImages } from '../../data/bee-products';
import { ogImageFor } from '../../data/og';
import { guideCard } from '../../data/guides';
import { product, faqPage, localBusiness } from '../../lib/schema';
import { whatsappLink } from '../../lib/whatsapp';

const pathname = apiRegine.path;
const crumbs = [{ name: apiRegine.name, path: pathname }];

/**
 * Voto e recensioni del prodotto: in pagina ne compaiono al massimo tre e sono
 * le stesse che finiscono nel JSON-LD (vedi README, "Scheda del miele").
 */
const reviews = (apiRegine.productReviews ?? []).slice(0, 3);
const hasReviews = reviews.length > 0;
const rating = apiRegine.rating;
const ratingLabel = rating ? rating.value.toFixed(1).replace('.', ',') : null;

/** Tre filmati dal nostro apiario: la linea raccontata per immagini. */
const videos = [
  {
    src: '/video/regina-f1-su-covate.mp4',
    poster: '/video/regina-f1-su-covate-poster-b231f1f2.avif',
    label: 'La regina F1 della nostra linea Buckfast sulle covate',
    cls: 'video-item--tall',
  },
  {
    src: '/video/nascita-di-una-regina.mp4',
    poster: '/video/nascita-di-una-regina-poster-f063b65c.avif',
    label: "La nascita di un'ape regina, in apiario",
    cls: 'video-item--tall',
  },
  {
    src: '/video/marcatura-della-regina.mp4',
    poster: '/video/marcatura-della-regina-poster-4e596bfb.avif',
    label: "Raffaele mostra come e perché si marca un'ape regina",
    cls: 'video-item--tall',
  },
];

const relatedCards = [
  {
    href: '/nuclei-api/',
    ...repartoImages.nuclei,
    title: "Nuclei d'api",
    text: 'Una famiglia già avviata con regina feconda e telai con covata: la via più semplice per partire.',
  },
  guideCard(
    'come-introdurre-una-nuova-ape-regina',
    'Come introdurre una nuova ape regina',
    'Tempi, metodo e controlli: la guida con gli errori da evitare quando si cambia regina.'
  ),
  {
    href: '/miele/',
    ...repartoImages.miele,
    title: 'I nostri mieli',
    text: 'Cinque mieli 100% italiani di api proprie, non pastorizzati: acacia, millefiori, castagno e, in stagione, il miele in favo.',
  },
];
---

<Base
  title={apiRegine.title}
  description={apiRegine.description}
  {pathname}
  ogImage={ogImageFor(pathname)}
  type="product"
  {crumbs}
  whatsappHref={whatsappLink(apiRegine.whatsappText)}
  jsonLd={[
    localBusiness(),
    // Le recensioni passate allo schema sono le stesse mostrate in pagina.
    product({ ...apiRegine, image: 'ape_regina_di_raffaele', gallery: [], productReviews: reviews }, pathname, {
      category: apiRegine.name,
    }),
    faqPage(apiRegine.faq),
  ]}
>
  <PageHero h1={apiRegine.h1} intro={apiRegine.heroIntro} crumbs={crumbs} />

  {/* Blocco prodotto: foto, prezzo, voto, caratteristiche e CTA. */}
  <section class="section" style="padding-top: var(--space-3);">
    <div class="container product-grid">
      <div class="product-media">
        <Picture
          base="ape_regina_di_raffaele"
          alt="L'ape regina dell'apiario di Raffaele Antoci, apicoltore di Bio & Golosità a Cassano d'Adda"
          sizes="(min-width: 900px) 520px, 100vw"
          loading="eager"
          fetchpriority="high"
        />
      </div>

      <div>
        <p class="product-price"><Price value={apiRegine.prezzo} /></p>

        {
          rating && hasReviews && (
            <div class="rating">
              <Stars value={rating.value} size={20} />
              <strong>{ratingLabel}/5</strong>
              <span>· {rating.count} recensioni</span>
              <a href="#recensioni">Leggi le recensioni</a>
            </div>
          )
        }

        <ul class="chips">
          {apiRegine.chips.map((c) => <li>{c}</li>)}
        </ul>

        <div class="contact-cta mt-3">
          <PhoneCta />
          <a class="btn btn-ghost btn-lg" href={whatsappLink(apiRegine.whatsappText)} target="_blank" rel="noopener">
            <Icons name="whatsapp" size={20} />
            Ordina su WhatsApp
          </a>
        </div>

        <p class="small-note">
          Ritiro a Cassano d'Adda o consegna a domicilio nelle{' '}
          <a href="/consegna-miele/">zone servite</a>.
        </p>
        <p class="small-note">{apiRegine.note}</p>
      </div>
    </div>
  </section>

  {/*
    "Come alleviamo le nostre regine": la sezione che vale più di ogni
    descrizione — da dove arrivano le madri, come nascono le regine e cosa
    controlliamo prima di venderle.
  */}
  <section class="section" aria-labelledby="origine">
    <div class="container">
      <div class="split split--photos">
        <div class="split-text">
          <span class="eyebrow">{apiRegine.origine.eyebrow}</span>
          <h2 id="origine">{apiRegine.origine.title}</h2>
          {apiRegine.origine.notes.map((n) => <p set:html={n} />)}
        </div>
        <figure class="split-media">
          <Picture
            base={apiRegine.origine.photo.base}
            alt={apiRegine.origine.photo.alt}
            sizes="(min-width: 900px) 45vw, 100vw"
            loading="lazy"
          />
          <figcaption>{apiRegine.origine.photo.caption}</figcaption>
        </figure>
      </div>

      <div class="features mt-4">
        {
          apiRegine.origine.items.map((o) => (
            <div class="feature">
              <div class="feature-icon"><Icons name={o.icon} size={26} /></div>
              <h3>{o.label}</h3>
              <p>{o.value}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <PhotoGallery
    id="video"
    photos={[]}
    {videos}
    columns={3}
    eyebrow="video"
    title="Le regine in video"
    intro="Tre filmati dal nostro apiario: la regina F1 sulle covate, come nasce una regina e come si marca."
  />

  {
    hasReviews && (
      <section class="section section--soft" id="recensioni" aria-labelledby="recensioni-title">
        <div class="container">
          <div class="section-head center" style="margin-inline:auto;">
            <span class="eyebrow">la parola ai clienti</span>
            <h2 id="recensioni-title">Chi ha comprato le nostre regine</h2>
          </div>

          <div class="reviews-grid">
            {reviews.map((r) => (
              <figure class="review">
                <Stars value={r.stars} />
                <blockquote>
                  <p>“{r.text}”</p>
                </blockquote>
                <figcaption>
                  <span class="review-author">{r.name}</span>
                </figcaption>
              </figure>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <Faq
    id="faq-title"
    items={apiRegine.faq}
    eyebrow="domande sulle api regine"
    title="Domande frequenti"
  />

  <LinkCards
    id="collegati"
    cards={relatedCards}
    soft
    eyebrow="scopri anche"
    title="Nuclei, guide e mieli"
  />

  <CtaBand
    eyebrow="ordina direttamente dall'apicoltore"
    title="Vuoi ordinare le api regine?"
    text="Scrivici per disponibilità, ritiro o consegna."
    whatsappLabel="Scrivi su WhatsApp"
    whatsappHref={whatsappLink(apiRegine.whatsappText)}
  />
</Base>
