---
import Emoji from '../components/Emoji.astro';
import Base from '../layouts/Base.astro';
import Picture from '../components/Picture.astro';
import Gallery from '../components/Gallery.astro';
import Testimonials from '../components/Testimonials.astro';
import ContactSection from '../components/ContactSection.astro';
import Icons from '../components/Icons.astro';
import PhoneCta from '../components/PhoneCta.astro';
import PriceBadge from '../components/PriceBadge.astro';
import ProductCards from '../components/ProductCards.astro';
import { site } from '../data/site';
import { ogImageFor } from '../data/og';
import { polline, apiRegine, nuclei, prezzoSuRichiesta, repartoImages } from '../data/bee-products';
import { priceFrom } from '../lib/price';
import { localBusiness, faqPage } from '../lib/schema';

/**
 * Home = bacheca dei prodotti. I 5 mieli hanno le loro schede complete su
 * /miele/ (griglia, prezzi, formati) e qui non si ripetono: da qui si sceglie
 * il *reparto* (miele, polline, regine, nuclei) e si entra nella pagina dedicata.
 */
const homeProducts = [
  {
    href: '/miele/',
    ...repartoImages.miele,
    title: 'I nostri mieli',
    text: 'Acacia, millefiori e castagno: mieli non pastorizzati e smielati a freddo. In stagione prepariamo anche il miele in favo.',
    price: priceFrom(site.honeys.flatMap((h) => h.priceFormats)),
  },
  {
    href: '/polline-d-api/',
    ...repartoImages.polline,
    title: "Polline d'api",
    text: "Raccolto dalle nostre api tra la Martesana e la Gera d'Adda: fresco o essiccato, con le indicazioni per conservarlo.",
    price: polline.prezzo ?? prezzoSuRichiesta,
  },
  {
    href: '/api-regine/',
    ...repartoImages.apiRegine,
    title: 'Api regine',
    text: 'Regine feconde della nostra linea Buckfast, per rinnovare un alveare o avviarne uno nuovo.',
    price: apiRegine.prezzo ?? prezzoSuRichiesta,
  },
  {
    href: '/nuclei-api/',
    ...repartoImages.nuclei,
    title: "Nuclei d'api",
    text: 'Famiglie già avviate con regina feconda e telai con covata: la via più semplice per partire.',
    price: nuclei.prezzo ?? prezzoSuRichiesta,
  },
];

const title = "Miele 100% Italiano a Cassano d'Adda | Bio & Golosità";
const description =
  "Miele artigianale 100% italiano di api proprie a Cassano d'Adda (MI), non pastorizzato e smielato a freddo. Vendita diretta e consegna in zona.";

const homeFaq = [
  {
    q: 'Il miele è prodotto direttamente da voi?',
    a: 'Sì. Gestiamo direttamente i nostri apiari e ci occupiamo personalmente della produzione e della smielatura.',
  },
  {
    q: 'Il miele è pastorizzato?',
    a: 'No. Il nostro miele non viene sottoposto a pastorizzazione.',
  },
  {
    q: 'Posso acquistare il miele direttamente dall\'apicoltore?',
    a: 'Sì. In azienda a Cassano d\'Adda, in Via Salvo D\'Acquisto 9, su appuntamento; oppure con consegna a domicilio nelle zone servite.',
  },
  {
    q: 'Fate consegne a domicilio?',
    a: 'Sì, tra Milano, Bergamo, Cremona e Lodi: spesso è gratuita, dipende dall\'ordine e dalla zona. Chiama o scrivi su WhatsApp e ti confermiamo subito.',
  },
];
---

<Base
  title={title}
  description={description}
  pathname="/"
  ogImage={ogImageFor('/')}
  preloadImage="apiari_hd"
  jsonLd={[localBusiness(), faqPage(homeFaq)]}
>

  {/*
    Inquadratura della hero: la foto è orizzontale (1672×941) e mostra gli
    apiari in mezzo al prato, con gli alberi e il cielo in alto. Le arnie
    (chiare) stanno nella fascia centrale, y 30–70%, e a sinistra del centro
    (x 12–25%), quindi:
    - da desktop la fascia taglia poco in altezza (10% a 1440, ~33% a 1920):
      col 50% si tengono cielo, arnie e prato;
    - su mobile la fascia è più alta che larga, quindi il taglio è
      ORIZZONTALE e si vede solo ~27% della larghezza: lì conta la X, e il 18%
      è la finestra che tiene dentro le arnie (misurato sui pixel chiari).
  */}
  <section class="hero hero--bg on-image" style="--hero-pos: 50% 50%; --hero-pos-m: 18% 50%">
    <div class="hero-bg-media" aria-hidden="true">
      <Picture
        base="apiari_hd"
        alt=""
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        zoomable={false}
      />
    </div>
    <div class="hero-bg-scrim" aria-hidden="true"></div>
    <div class="container">
      <div class="hero-text">
        <span class="eyebrow">Cassano d'Adda (MI)</span>
        <h1>
          Miele artigianale 100% italiano, direttamente dall'apicoltore
        </h1>
        <p class="hero-sub">
            Dai nostri apiari, non pastorizzato e smielato a freddo.
        </p>
        <div class="hero-cta">
          <a class="btn btn-primary btn-lg" href="/miele/">
            Scopri i nostri mieli
            <Icons name="arrow" size={20} />
          </a>
          <PhoneCta variant="ghost" />
        </div>
        {/* Un'icona per il significato di ogni riga, non tre check identici:
            la spunta per il dato secco, il segnaposto per le zone di consegna,
            la stella (piena, come in Testimonials) per il voto su Google. */}
        <ul class="trust">
          <li><Icons name="check" size={18} /> Cinque mieli tra cui scegliere</li>
          <li><Icons name="pin" size={18} /> Consegna a domicilio tra Milano, Bergamo, Cremona e Lodi</li>
          <li><Icons name="star" size={18} /> 5,0 su Google · 30+ recensioni</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section section--soft" id="prodotti" aria-labelledby="prodotti-title">
    <div class="container">
      <div class="section-head center" style="margin-inline:auto;">
        <span class="eyebrow">non solo miele</span>
        <h2 id="prodotti-title">I nostri prodotti</h2>
        <p>
          Miele, polline, api regine e nuclei: tutto di produzione propria, venduto
          direttamente.
        </p>
      </div>
      <ProductCards cards={homeProducts} linkLabel="Vedi prezzi e disponibilità" />
    </div>
  </section>

  <section class="section" aria-labelledby="why-title">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">perché scegliere il nostro miele<Emoji name="honey-pot" /></span>
        <h2 id="why-title">Miele artigianale direttamente dall'apicoltore</h2>
        <p>
          Niente miscele anonime: ogni barattolo nasce dalle nostre api e
          racconta le fioriture dei territori in cui lavoriamo.
        </p>
      </div>
      <div class="features">
        <div class="feature">
          <div class="feature-icon"><Icons name="package" size={26} /></div>
          <h3>Non pastorizzato</h3>
          <p>Smielato e invasettato senza pastorizzazione, per preservare il profilo aromatico, il gusto e le caratteristiche naturali del raccolto.</p>
        </div>
        <div class="feature">
          <div class="feature-icon"><Icons name="leaf" size={26} /></div>
          <h3>Miele 100% italiano</h3>
          <p>Miele artigianale di produzione propria, raccolto dalle nostre api negli apiari della Lombardia.</p>
        </div>
        <div class="feature">
          <div class="feature-icon"><Icons name="shield" size={26} /></div>
          <h3>Apicoltore dal {site.apicoltoreDal}</h3>
          <p>Dal {site.apicoltoreDal} mi prendo cura personalmente delle mie api, tra la Martesana e la Gera d'Adda.</p>
        </div>
        <div class="feature">
          <div class="feature-icon"><Icons name="sparkle" size={26} /></div>
          <h3>Prezzo onesto</h3>
          <p>Vendita diretta dall'apicoltore, senza intermediari: acquisti il miele direttamente da chi alleva le api, lo raccoglie e lo confeziona.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--soft" aria-labelledby="about-title">
    <div class="container split">
      <div class="split-media">
        <Picture
          base="raffaele_sorridente_con_le_sue_api"
          alt="Raffaele Antoci, apicoltore di Bio & Golosità, sorridente con le sue api a Cassano d'Adda"
          sizes="(min-width: 900px) 45vw, 100vw"
          loading="lazy"
        />
      </div>
      <div class="split-text">
        <span class="eyebrow">il tuo apicoltore<Emoji name="honeybee" /></span>
        <h2 id="about-title">Mi chiamo Raffaele e le api sono la mia passione</h2>
        <p>
          Ho gli apiari a Cassano d'Adda e nelle campagne tra la Gera d'Adda e
          la Martesana. Ogni barattolo di
          Bio & Golosità è il risultato del mio lavoro paziente, fatto di
          controlli in apiario, fioriture seguite settimana per settimana e
          smielatura a freddo.
        </p>
        <ul>
          <li><Icons name="check" size={20} /> Apiari che gestisco io, senza intermediari</li>
          <li><Icons name="check" size={20} /> Miele locale della provincia di Milano e dintorni</li>
          <li><Icons name="check" size={20} /> Lavoro artigianale, a piccoli lotti</li>
        </ul>
        <a class="btn btn-primary btn-lg mt-3" href="/chi-siamo/">
          La mia storia
          <Icons name="arrow" size={20} />
        </a>
      </div>
    </div>
  </section>

  <Gallery />

  <section class="section section--soft" aria-labelledby="zone-title">
    <div class="container">
      <div class="section-head center" style="margin-inline:auto;">
        <span class="eyebrow">dove siamo e dove consegniamo</span>
        <h2 id="zone-title">Vendita e consegna di miele a Cassano d'Adda e nella Martesana</h2>
        <p>
          Ci troviamo in Via Salvo D'Acquisto 9 a
          Cassano d'Adda. Vendiamo direttamente il nostro miele e consegniamo
          nella Martesana, nella Gera d'Adda e in diversi comuni tra Milano,
          Bergamo, Cremona e Lodi.
        </p>
      </div>
      <ul class="chips" style="justify-content:center;">
        {site.areaServedFeatured.map((t) => <li>{t}</li>)}
      </ul>
      <p class="mt-3" style="text-align:center;">…e in molti altri comuni.</p>
      <div class="contact-cta mt-4" style="justify-content:center;">
        <a class="btn btn-ghost btn-lg" href="/consegna-miele/">
          Vedi dove consegniamo
          <Icons name="arrow" size={20} />
        </a>
      </div>
    </div>
  </section>

  <Testimonials />

  <section class="section section--soft" aria-labelledby="faq-title">
    <div class="container">
      <div class="section-head center" style="margin-inline:auto;">
        <span class="eyebrow">domande frequenti</span>
        <h2 id="faq-title">Tutto quello che vuoi sapere</h2>
      </div>
      <div class="faq">
        {
          homeFaq.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <ContactSection />
</Base>
