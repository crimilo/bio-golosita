---
import Base from '../layouts/Base.astro';
import Picture from '../components/Picture.astro';
import HoneyCard from '../components/HoneyCard.astro';
import Gallery from '../components/Gallery.astro';
import Testimonials from '../components/Testimonials.astro';
import ContactSection from '../components/ContactSection.astro';
import Icons from '../components/Icons.astro';
import { site } from '../data/site';
import { localBusiness, faqPage } from '../lib/schema';

const title = "Miele 100% italiano vicino a me | Bio & Golosità";
const description =
  "Miele di Acacia € 6,00 · Miele Millefiori € 5,00 · Miele di Castagno € 6,50 · Cassano d'Adda (MI) e provincia · Non pastorizzato · Chiama per ordinare";

const homeFaq = [
  {
    q: 'Vendete anche secchi da 10 kg o quantità grandi?',
    a: 'Sì: per ordini superiori a 10 kg prepariamo secchi da 10 kg con un prezzo personalizzato e leggermente scontato. Contattaci per un preventivo su misura: chiama o scrivi su WhatsApp.',
  },
  {
    q: 'Il vostro miele è 100% italiano?',
    a: 'Sì: tutto il nostro miele è 100% italiano e artigianale. Le api sono nostre e gli apiari si trovano tra Cassano d\'Adda, la Gera d\'Adda, la Martesana, il Parco Nord Milano e la Val Brembana: un miele di produzione propria, raccolto e smielato a pochi chilometri da casa tua.',
  },
  {
    q: 'Dove posso comprare il vostro miele?',
    a: 'Puoi ritirare il miele direttamente in azienda a Cassano d\'Adda, in Via Salvo D\'Acquisto 9, su appuntamento: chiama o scrivi su WhatsApp prima di passare, così ti aspettiamo. Oppure possiamo portartelo a casa: la consegna può essere gratuita, dipende dall\'ordine e da dove mi trovo quando mi chiami — chiamaci e ti confermo subito.',
  },
  {
    q: 'Il miele cristallizza: è normale?',
    a: 'Sì, è assolutamente naturale: la cristallizzazione è un processo spontaneo del miele puro e non pastorizzato. Per riportarlo fluido basta scaldare il barattolo a bagnomaria a bassa temperatura.',
  },
  {
    q: 'Fate consegne?',
    a: 'Sì: consegniamo a domicilio nella nostra zona tra Milano, Bergamo e Cremona: Cassano d\'Adda, Groppello d\'Adda, Fara Gera d\'Adda, Trezzo sull\'Adda, Vaprio d\'Adda, il Parco Nord Milano, Treviglio, Gorgonzola, Melzo, Pozzuolo Martesana, Inzago, Rivolta d\'Adda, Vailate e Caravaggio. La consegna può essere gratuita: dipende dall\'ordine e da dove mi trovo quando mi chiami, quindi chiama o scrivici su WhatsApp e ti confermo subito. In alternativa puoi ritirare in sede su appuntamento.',
  },
  {
    q: 'Da dove viene il vostro miele?',
    a: 'Il miele viene dai miei apiari, che gestisco io con api proprie, tra Cassano d\'Adda, la Gera d\'Adda, la Martesana, il Parco Nord Milano e la Val Brembana. È un miele locale, raccolto e smielato a pochi chilometri da casa tua.',
  },
];
---

<Base
  title={title}
  description={description}
  pathname="/"
  preloadHero={true}
  jsonLd={[localBusiness(), faqPage(homeFaq)]}
>

  <section class="hero">
    <div class="container hero-grid">
      <div>
        <span class="eyebrow">api proprie · dal 2020</span>
        <h1>
          Miele genuino a Cassano d'Adda e in tutta la provincia di Milano
        </h1>
        <p class="hero-sub">
          Acacia, millefiori e castagno: miele 100% italiano di api proprie,
          non pastorizzato. Consegna a domicilio a Cassano d'Adda e dintorni,
          in molti casi gratuita: chiama e ti confermiamo. Oppure ritiro in
          sede su appuntamento.
        </p>
        <div class="hero-cta">
          <a class="btn btn-primary btn-lg" href="#mieli">
            Scopri i nostri mieli
            <Icons name="arrow" size={20} />
          </a>
          <a class="btn btn-ghost btn-lg" href={site.phoneHref}>
            <Icons name="phone" size={20} />
            Chiama ora
          </a>
        </div>
        <ul class="trust">
          <li><Icons name="check" size={18} /> 100% Made in Italy</li>
          <li><Icons name="check" size={18} /> Api proprie</li>
          <li><Icons name="check" size={18} /> Miele non pastorizzato</li>
          <li><Icons name="check" size={18} /> {site.experienceYears} anni di esperienza</li>
          <li><Icons name="check" size={18} /> Possibile consegna gratuita</li>
        </ul>
      </div>
      <div class="hero-media">
        <Picture
          base="hero_bg"
          alt="Tre barattoli di miele di acacia, millefiori e castagno di Bio & Golosità a Cassano d'Adda"
          sizes="(min-width: 900px) 42vw, 100vw"
          loading="eager"
          fetchpriority="high"
        />
        <span class="hero-badge">100% Made in Italy · api proprie</span>
      </div>
    </div>
  </section>

  <section class="section section--soft" id="mieli" aria-labelledby="mieli-title">
    <div class="container">
      <div class="section-head center" style="margin-inline:auto;">
        <span class="eyebrow">direttamente dall'apiario</span>
        <h2 id="mieli-title">I nostri mieli</h2>
        <p>
          Cinque mieli di stagione, raccolti e smielati da me nei miei
          apiari tra Cassano d'Adda, la Gera d'Adda, la Martesana, il Parco
          Nord Milano e la Val Brembana.
        </p>
      </div>
      <div class="honey-grid">
        {
          site.honeys.map((h, i) => (
            <HoneyCard honey={h} eager={i === 0} />
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="why-title">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">perché scegliere il nostro miele</span>
        <h2 id="why-title">Miele vero, fatto come una volta</h2>
        <p>
          Niente miscele anonime: ogni barattolo racconta le fioriture della
          nostra zona.
        </p>
      </div>
      <div class="features">
        <div class="feature">
          <div class="feature-icon"><Icons name="home" size={26} /></div>
          <h3>Api proprie</h3>
          <p>Gestisco i miei apiari in prima persona: sai sempre da dove arriva il tuo miele.</p>
        </div>
        <div class="feature">
          <div class="feature-icon"><Icons name="package" size={26} /></div>
          <h3>Non pastorizzato</h3>
          <p>Smielato a freddo e non pastorizzato, conserva polline, enzimi e profumi originali.</p>
        </div>
        <div class="feature">
          <div class="feature-icon"><Icons name="leaf" size={26} /></div>
          <h3>100% Made in Italy</h3>
          <p>Miele artigianale italiano, di api proprie, raccolto tra la Martesana e la Gera d'Adda.</p>
        </div>
        <div class="feature">
          <div class="feature-icon"><Icons name="shield" size={26} /></div>
          <h3>{site.experienceYears} anni di esperienza</h3>
          <p>Dal 2020 curo le api con passione e metodi rispettosi dell'ambiente.</p>
        </div>
        <div class="feature">
          <div class="feature-icon"><Icons name="sparkle" size={26} /></div>
          <h3>Prezzo onesto</h3>
          <p>Vendita diretta dall'apicoltore: qualità alta al prezzo giusto, senza intermediari.</p>
        </div>
        <div class="feature">
          <div class="feature-icon"><Icons name="clock" size={26} /></div>
          <h3>Ritiro e consegna rapidi</h3>
          <p>Ritiro in sede su appuntamento a Cassano d'Adda o consegna a domicilio in tutta la zona tra Milano, Bergamo e Cremona: in molti casi gratuita, chiama e ti confermiamo.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--soft" aria-labelledby="about-title">
    <div class="container split">
      <div class="split-media">
        <Picture
          base="raffaele_sorridente_con_le_sue_api"
          alt="Raffaele Antoci, apicoltore di Bio & Golosità, sorridente con le sue api a Cassano d'Adda"
          sizes="(min-width: 900px) 45vw, 100vw"
          loading="lazy"
        />
      </div>
      <div class="split-text">
        <span class="eyebrow">il tuo apicoltore</span>
        <h2>Mi chiamo Raffaele e le api sono la mia passione</h2>
        <p>
          Da <strong>oltre 6 anni</strong> mi prendo cura delle mie api a Cassano
          d'Adda e nelle campagne tra la Gera d'Adda e la Martesana. Ogni
          barattolo di Bio & Golosità è il risultato del mio lavoro paziente,
          fatto di controlli in apiario, fioriture seguite settimana per
          settimana e smielatura a freddo.
        </p>
        <ul>
          <li><Icons name="check" size={20} /> Apiari che gestisco io, senza intermediari</li>
          <li><Icons name="check" size={20} /> Miele locale della provincia di Milano e dintorni</li>
          <li><Icons name="check" size={20} /> Lavoro artigianale, a piccoli lotti</li>
          <li><Icons name="check" size={20} /> Mi occupo della salute delle api e dell'ambiente</li>
        </ul>
        <a class="btn btn-primary btn-lg mt-3" href="/chi-siamo/">
          La mia storia
          <Icons name="arrow" size={20} />
        </a>
      </div>
    </div>
  </section>

  <Gallery />

  <section class="section section--soft" aria-labelledby="zone-title">
    <div class="container">
      <div class="section-head center" style="margin-inline:auto;">
        <span class="eyebrow">dove siamo e dove consegniamo</span>
        <h2 id="zone-title">Cassano d'Adda, al centro tra Milano, Bergamo, Cremona e Lodi</h2>
        <p>
          La nostra azienda è in Via Salvo D'Acquisto 9 a Cassano d'Adda, al
          confine tra le province di Milano, Bergamo, Cremona e Lodi. Vendita
          diretta in sede su appuntamento e consegna a domicilio, in molti
          casi gratuita — chiama e ti confermiamo — nella Martesana, nella
          Gera d'Adda, fino a Trezzo sull'Adda, Vaprio d'Adda, al Parco Nord
          Milano e in tutta la provincia di Milano.
        </p>
      </div>
      <ul class="chips" style="justify-content:center;">
        {site.areaServed.map((t) => <li>{t}</li>)}
      </ul>
    </div>
  </section>

  <Testimonials />

  <section class="section" aria-labelledby="cta-title">
    <div class="container">
      <div class="cta-band">
        <span class="eyebrow" style="color:#ffe9bf;">il miele è pronto</span>
        <h2 id="cta-title">Hai voglia di miele vero? Chiama ora</h2>
        <p>
          Una telefonata di trenta secondi e il tuo miele di Cassano d'Adda è
          prenotato. Se preferisci, scrivici su WhatsApp.
        </p>
        <div class="contact-cta" style="justify-content:center;">
          <a class="btn btn-light btn-lg" href={site.phoneHref}>
            <Icons name="phone" size={20} />
            Chiama ora
          </a>
          <a class="btn btn-ghost btn-lg" style="border-color:#ffe9bf;color:#ffe9bf;" href={site.whatsapp} target="_blank" rel="noopener">
            <Icons name="whatsapp" size={20} />
            WhatsApp
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="faq-title">
    <div class="container">
      <div class="section-head center" style="margin-inline:auto;">
        <span class="eyebrow">domande frequenti</span>
        <h2 id="faq-title">Tutto quello che vuoi sapere</h2>
      </div>
      <div class="faq">
        {
          homeFaq.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <ContactSection />
</Base>
