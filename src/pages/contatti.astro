---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ContactSection from '../components/ContactSection.astro';
import { site } from '../data/site';
import { ogImageFor } from '../data/og';
import { localBusiness } from '../lib/schema';

const title = 'Contatti Miele Cassano d\'Adda | Bio & Golosità';
const description =
  "Contatta Bio & Golosità a Cassano d'Adda (MI): telefono, WhatsApp, indirizzo e orari. Ordina il tuo miele in pochi secondi, ritiro o consegna in zona.";
const crumbs = [{ name: 'Contatti', path: '/contatti/' }];
const heroImg = 'apiario';

// Nessun `FAQPage` qui: le domande su come ordinare e dove siamo non sono
// visibili in pagina (il blocco contatti dà le stesse informazioni in altra
// forma) e Google chiede che il contenuto delle FAQ si veda. Il `FAQPage` resta
// nelle pagine che lo rendono davvero: mieli, prodotti dell'alveare, guide.
---

<Base
  title={title}
  description={description}
  pathname="/contatti/"
  ogImage={ogImageFor('/contatti/')}
  crumbs={crumbs}
  preloadImage={heroImg}
  jsonLd={[localBusiness()]}
>
  <PageHero
    h1="Contattaci"
    crumbs={crumbs}
    bg={{ base: heroImg, position: '50% 50%', positionMobile: '50% 45%' }}
    intro="Il modo più veloce per ordinare il nostro miele: una chiamata o un messaggio WhatsApp. Siamo a Cassano d'Adda (MI), raggiungibili in poco tempo da Milano, Bergamo, Treviglio e Gorgonzola."
  />

  <ContactSection />
</Base>
