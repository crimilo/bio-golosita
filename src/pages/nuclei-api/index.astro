---
/**
 * /nuclei-api/ — scheda prodotto con la **stessa struttura delle schede miele**
 * (`miele/[slug].astro`): hero corta, blocco prodotto (foto, prezzo, voto,
 * caratteristiche, CTA), "Da dove arriva questo nucleo" (paragrafo + quattro
 * dati), la galleria, recensioni del prodotto, FAQ, "scopri anche" e chiusura
 * compatta.
 *
 * Quello che prima stava in tre posti diversi — scheda tecnica, paragrafi e
 * tracciabilità — adesso vive in un posto solo: l'origine, il blocco prodotto e
 * le FAQ. I testi arrivano da `nuclei` (`origine.notes`, `origine.items`,
 * `chips`, `note`). La foto principale è `sciame_4`: un telaio pieno di api,
 * estratto da un'arnia e tenuto in mano in apiario. È **quello che si porta a
 * casa con un nucleo** (telai con api e covata), e non uno sciame: la differenza
 * è spiegata nelle FAQ, quindi l'alt non deve suggerire un grappolo su un ramo.
 */
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Picture from '../../components/Picture.astro';
import Price from '../../components/Price.astro';
import PhotoGallery from '../../components/PhotoGallery.astro';
import ProductCards from '../../components/ProductCards.astro';
import Faq from '../../components/Faq.astro';
import CtaBand from '../../components/CtaBand.astro';
import Stars from '../../components/Stars.astro';
import Icons from '../../components/Icons.astro';
import PhoneCta from '../../components/PhoneCta.astro';
import { site } from '../../data/site';
import { nuclei, apiRegine, repartoImages } from '../../data/bee-products';
import { ogImageFor } from '../../data/og';
import { priceFrom } from '../../lib/price';
import { product, faqPage, localBusiness } from '../../lib/schema';
import { whatsappLink } from '../../lib/whatsapp';

const pathname = nuclei.path;
const crumbs = [{ name: nuclei.name, path: pathname }];

/** Voto e recensioni del prodotto: al massimo tre in pagina, le stesse nel JSON-LD. */
const reviews = (nuclei.productReviews ?? []).slice(0, 3);
const hasReviews = reviews.length > 0;
const rating = nuclei.rating;
const ratingLabel = rating ? rating.value.toFixed(1).replace('.', ',') : null;

/**
 * Foto della galleria: tutte quelle dei nuclei tranne le due già usate in pagina
 * (`sciame_4` nel blocco prodotto, `sciame_5` accanto a "Da dove arriva").
 */
const gallery = nuclei.gallery.filter(
  (p) => p.base !== 'sciame_4' && p.base !== 'sciame_5'
);

const galleryVideo = {
  src: '/video/api-che-si-creano-spazio.mp4',
  poster: '/video/api-che-si-creano-spazio-poster-4d6062c5.avif',
  label: 'Le api che si sono create lo spazio da sole',
  cls: 'video-item--tall',
};

/** "Gli altri prodotti": la stessa idea delle card "Gli altri mieli". */
const otherProducts = [
  {
    href: '/miele/',
    ...repartoImages.miele,
    title: 'I nostri mieli',
    text: 'Acacia, millefiori e castagno: mieli non pastorizzati e smielati a freddo. In stagione prepariamo anche il miele in favo.',
    price: priceFrom(site.honeys.flatMap((h) => h.priceFormats)),
  },
  {
    href: '/api-regine/',
    ...repartoImages.apiRegine,
    title: 'Api regine',
    text: 'Regine feconde della nostra linea Buckfast, per rinnovare un alveare o avviarne uno nuovo.',
    price: apiRegine.prezzo ?? null,
  },
];
---

<Base
  title={nuclei.title}
  description={nuclei.description}
  {pathname}
  ogImage={ogImageFor(pathname)}
  type="product"
  {crumbs}
  whatsappHref={whatsappLink(nuclei.whatsappText)}
  jsonLd={[
    localBusiness(),
    product({ ...nuclei, image: 'sciame_4', gallery: [], productReviews: reviews }, pathname, {
      category: nuclei.name,
    }),
    faqPage(nuclei.faq),
  ]}
>
  <PageHero h1={nuclei.h1} intro={nuclei.heroIntro} crumbs={crumbs} />

  {/* Blocco prodotto: foto, prezzo, voto, caratteristiche e CTA. */}
  <section class="section" style="padding-top: var(--space-3);">
    <div class="container product-grid">
      <div class="product-media">
        <Picture
          base="sciame_4"
          alt="Un telaio pieno di api, estratto da un'arnia e tenuto in mano nel nostro apiario, nel Parco Adda Nord e in Alta Val Brembana"
          sizes="(min-width: 900px) 520px, 100vw"
          loading="eager"
          fetchpriority="high"
        />
      </div>

      <div>
        <p class="product-price"><Price value={nuclei.prezzo} /></p>

        {
          rating && hasReviews && (
            <div class="rating">
              <Stars value={rating.value} size={20} />
              <strong>{ratingLabel}/5</strong>
              <span>· {rating.count} recensioni</span>
              <a href="#recensioni">Leggi le recensioni</a>
            </div>
          )
        }

        <ul class="chips">
          {nuclei.chips.map((c) => <li>{c}</li>)}
        </ul>

        <div class="contact-cta mt-3">
          <PhoneCta />
          <a class="btn btn-ghost btn-lg" href={whatsappLink(nuclei.whatsappText)} target="_blank" rel="noopener">
            <Icons name="whatsapp" size={20} />
            Ordina su WhatsApp
          </a>
        </div>

        <p class="small-note">
          Ritiro a Cassano d'Adda o consegna a domicilio nelle{' '}
          <a href="/consegna-miele/">zone servite</a>.
        </p>
        <p class="small-note">{nuclei.note}</p>
      </div>
    </div>
  </section>

  {/*
    "Da dove arriva questo nucleo": origine, composizione, periodo di
    preparazione — quello che solo un allevatore può documentare.
  */}
  <section class="section" aria-labelledby="origine">
    <div class="container">
      <div class="split split--photos">
        <div class="split-text">
          <span class="eyebrow">{nuclei.origine.eyebrow}</span>
          <h2 id="origine">{nuclei.origine.title}</h2>
          {nuclei.origine.notes.map((n) => <p set:html={n} />)}
        </div>
        <figure class="split-media">
          <Picture
            base={nuclei.origine.photo.base}
            alt={nuclei.origine.photo.alt}
            sizes="(min-width: 900px) 45vw, 100vw"
            loading="lazy"
          />
          <figcaption>{nuclei.origine.photo.caption}</figcaption>
        </figure>
      </div>

      <div class="features mt-4">
        {
          nuclei.origine.items.map((o) => (
            <div class="feature">
              <div class="feature-icon"><Icons name={o.icon} size={26} /></div>
              <h3>{o.label}</h3>
              <p>{o.value}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <PhotoGallery
    id="foto"
    photos={gallery}
    videos={[galleryVideo]}
    columns={3}
    eyebrow="foto"
    title="I nostri nuclei e gli apiari"
    intro="Le famiglie da cui prepariamo i nuclei, il lavoro sui telai e il posto dove nascono."
  />

  {
    hasReviews && (
      <section class="section section--soft" id="recensioni" aria-labelledby="recensioni-title">
        <div class="container">
          <div class="section-head center" style="margin-inline:auto;">
            <span class="eyebrow">la parola ai clienti</span>
            <h2 id="recensioni-title">Chi ha comprato i nostri nuclei</h2>
          </div>

          <div class="reviews-grid">
            {reviews.map((r) => (
              <figure class="review">
                <Stars value={r.stars} />
                <blockquote>
                  <p>“{r.text}”</p>
                </blockquote>
                <figcaption>
                  <span class="review-author">{r.name}</span>
                </figcaption>
              </figure>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <Faq
    id="faq-title"
    items={nuclei.faq}
    eyebrow="domande sui nuclei"
    title="Domande frequenti"
  />

  <section class="section section--soft" aria-labelledby="other-title">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">scopri anche</span>
        <h2 id="other-title">Gli altri prodotti di Bio &amp; Golosità</h2>
        <p>
          Dai un'occhiata agli <a href="/miele/">altri prodotti di nostra produzione</a>, oppure
          leggi la guida{' '}
          <a href="/guide/nucleo-sciame-pacco-dapi-differenze/">
            nucleo, sciame o pacco d'api
          </a>.
        </p>
      </div>
      <ProductCards cards={otherProducts} />
    </div>
  </section>

  <CtaBand
    eyebrow="ordina direttamente dall'apicoltore"
    title="Vuoi ordinare un nucleo d'api?"
    text="Scrivici per disponibilità, ritiro o consegna."
    whatsappLabel="Scrivi su WhatsApp"
    whatsappHref={whatsappLink(nuclei.whatsappText)}
  />
</Base>
