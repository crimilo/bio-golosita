---
/**
 * Schede del miele — le quattro varietà (`site.honeys`) e il miele in favo
 * (`site.honeyComb`), tutte da questo template.
 *
 * La struttura è quella nata per il miele di acacia e poi estesa a tutte le
 * schede: hero corta, blocco prodotto (foto, prezzo, voto, quattro
 * caratteristiche, CTA), "Da dove arriva" (foto dell'apiario, quattro dati di
 * origine, il video della lavorazione), recensioni del prodotto, FAQ, altri
 * mieli e chiusura compatta. Niente scheda tecnica e niente sezione
 * descrittiva: colore, gusto, usi e conservazione stanno nelle `characteristics`
 * del blocco prodotto e nelle FAQ, una volta sola, invece di essere ripetuti in
 * tre modi diversi.
 *
 * Tutto quello che cambia da scheda a scheda arriva dai dati (`site.js`), non da
 * questo file: qui si sceglie solo l'ordine delle sezioni. Struttura e campi
 * sono descritti nel README.
 */
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Picture from '../../components/Picture.astro';
import HoneyCard from '../../components/HoneyCard.astro';
import PhotoGallery from '../../components/PhotoGallery.astro';
import Faq from '../../components/Faq.astro';
import CtaBand from '../../components/CtaBand.astro';
import VideoFigure from '../../components/VideoFigure.astro';
import Stars from '../../components/Stars.astro';
import Icons from '../../components/Icons.astro';
import PhoneCta from '../../components/PhoneCta.astro';
import { site, honeyProducts } from '../../data/site';
import { ogImageFor } from '../../data/og';
import { prezzoNota, prezzoSuRichiesta } from '../../data/bee-products';
import { entryFormat, otherFormats } from '../../lib/price';
import { product, faqPage, localBusiness } from '../../lib/schema';

export function getStaticPaths() {
  // tutte le schede del miele: le quattro varietà e il miele in favo
  return honeyProducts.map((h) => ({
    params: { slug: h.slug },
    props: { honey: h },
  }));
}

const { honey } = Astro.props;
const pathname = `/miele/${honey.slug}/`;
const crumbs = [
  { name: 'I nostri mieli', path: '/miele/' },
  { name: honey.name, path: pathname },
];

// Prezzo ben visibile: il formato d'ingresso in grande, gli altri in una riga
// più piccola sotto. Il miele in favo non ha un prezzo pubblicato: in quel caso
// si mostra "Prezzo su richiesta" con la sua nota, senza numeri inventati.
const priceEntry = entryFormat(honey.priceFormats);
const priceOthers = otherFormats(honey.priceFormats);

/**
 * Voto e recensioni del prodotto — non della scheda Google dell'azienda, che
 * resta in `site.reviews` e non alimenta il `Product`.
 *
 * In pagina ne compaiono **al massimo tre**, e sono esattamente le stesse che
 * finiscono nel JSON-LD: il markup non può raccontare recensioni che non si
 * vedono. `rating.count` invece è il totale vero delle recensioni del prodotto e
 * può essere più alto: quelle che non hanno un testo non servono in pagina.
 */
const reviews = (honey.productReviews ?? []).slice(0, 3);
const hasReviews = reviews.length > 0;
const rating = honey.rating;
const ratingLabel = rating ? rating.value.toFixed(1).replace('.', ',') : null;

/**
 * "Da dove arriva": i quattro dati dell'origine. Raccolta e lavorazione arrivano
 * dai dati della scheda, perché cambiano da miele a miele (il miele in favo, per
 * esempio, non si smiela affatto); gli apiari sono tutti in Lombardia, e le zone
 * precise stanno nella frase qui sopra, `originNote`.
 */
const harvestLabel = (() => {
  // "Raccolto a giugno" → "A giugno": in pagina il prefisso è già nel titolo
  // della voce ("Raccolta").
  const v = honey.harvest.replace(/^Raccolto /, '');
  return v.charAt(0).toUpperCase() + v.slice(1);
})();

const origin = [
  { icon: 'pin', label: 'Origine', value: 'Lombardia, Italia' },
  {
    icon: 'clock',
    label: 'Raccolta',
    // L'annata è un dato facoltativo, da compilare a mano: se c'è si mostra
    // sotto lo stesso dato, invece di sparire dalla pagina.
    value: honey.annata ? `${harvestLabel} · ${honey.annata}` : harvestLabel,
  },
  {
    icon: 'leaf',
    label: 'Lavorazione',
    value:
      honey.workNote ?? 'Smielatura a freddo, decantazione, nessuna pastorizzazione',
  },
  { icon: 'shield', label: 'Produzione', value: 'Api proprie' },
];

const others = honeyProducts.filter((h) => h.slug !== honey.slug).slice(0, 3);
---

<Base
  title={honey.title}
  description={honey.description}
  pathname={pathname}
  ogImage={ogImageFor(pathname)}
  type="product"
  crumbs={crumbs}
  jsonLd={[
    localBusiness(),
    // Le recensioni passate allo schema sono le stesse mostrate in pagina,
    // già tagliate a tre: vedi `reviews` qui sopra.
    product({ ...honey, productReviews: reviews }, pathname, {
      category: honey.category ?? 'Miele',
    }),
    faqPage(honey.faq),
  ]}
>
  {/*
    Hero: solo H1 e sottotitolo corto. Niente `variant="product"`: il paragrafo
    resta leggibile anche da mobile (è breve e dice subito cosa si sta
    comprando), quindi non si usa la regola che lo nasconde sotto i 900px.
    Il voto non sta qui: sta nel blocco prodotto, sotto il prezzo, dove serve a
    chi sta decidendo se comprare.
  */}
  <PageHero h1={honey.name} intro={honey.heroIntro} crumbs={crumbs} />

  {/*
    Blocco prodotto: foto, prezzo, voto, le caratteristiche e le CTA. Deve
    rispondere a "cosa compro, quanto costa, com'è, come lo ordino" e niente
    altro: la tracciabilità sta nella sezione "Da dove arriva".
  */}
  <section class="section" style="padding-top: var(--space-3);">
    <div class="container product-grid">
      <div class="product-media">
        <Picture
          base={honey.cardImage ?? honey.image}
          alt={`${honey.name} — Bio & Golosità, Cassano d'Adda (MI)`}
          sizes="(min-width: 900px) 520px, 100vw"
          loading="eager"
          fetchpriority="high"
          objectPosition={honey.imgPos}
        />
      </div>

      <div>
        <p class="product-price">
          {
            priceEntry ? (
              <>
                <span class="price-main">{priceEntry.price}</span>
                <span class="price-unit">({priceEntry.size})</span>
                {priceOthers.length > 0 && (
                  <span class="price-more">
                    {priceOthers.map((f) => `${f.size}: ${f.price}`).join(' · ')}
                  </span>
                )}
              </>
            ) : (
              // prezzo non pubblicato nei dati: niente numeri inventati
              <span class="price-main">{prezzoSuRichiesta}</span>
            )
          }
        </p>
        {!priceEntry && <p class="price-note">{prezzoNota}</p>}

        {/* Voto sotto il prezzo, con il link alle recensioni: nel punto in cui
            si decide, non nella hero. */}
        {
          rating && hasReviews && (
            <div class="rating">
              <Stars value={rating.value} size={20} />
              <strong>{ratingLabel}/5</strong>
              <span>· {rating.count} recensioni</span>
              <a href="#recensioni">Leggi le recensioni</a>
            </div>
          )
        }

        <ul class="chips">
          {honey.characteristics.map((c) => <li>{c}</li>)}
        </ul>

        <div class="contact-cta mt-3">
          <PhoneCta />
          <a class="btn btn-ghost btn-lg" href={site.whatsapp} target="_blank" rel="noopener">
            <Icons name="whatsapp" size={20} />
            Ordina su WhatsApp
          </a>
        </div>

        <p class="small-note">
          Ritiro a Cassano d'Adda o consegna a domicilio nelle{' '}
          <a href="/consegna-miele/">zone servite</a>.
        </p>
        <p class="small-note">
          {/* Il miele in favo ha una nota sua: la disponibilità è poca e solo
              su prenotazione (vedi `note` nei dati). */}
          {honey.note ?? site.bulkNote}
        </p>
      </div>
    </div>
  </section>

  {/*
    "Da dove arriva": origine, periodo di raccolta, lavorazione e api proprie,
    con la foto dell'apiario e il video della lavorazione del raccolto. È la
    sezione che vale più di tutte le descrizioni.
  */}
  <section class="section" aria-labelledby="origine">
    <div class="container">
      <div class="split split--photos">
        <div class="split-text">
          <span class="eyebrow">dai nostri apiari</span>
          <h2 id="origine">Da dove arriva</h2>
          <p>{honey.originNote}</p>
        </div>
        <figure class="split-media">
          <Picture
            /* `photo` è una foto *di prodotto* da preferire a quella dell'apiario
               (nessuna scheda la usa oggi); `apiaryPhoto` sceglie un'altra foto
               dell'apiario, con la stessa didascalia: le schede se la alternano,
               così non mostrano tutte la stessa. Senza né l'una né l'altra,
               `apiari_hd`. */
            base={honey.photo ?? honey.apiaryPhoto ?? 'apiari_hd'}
            alt={
              honey.photo
                ? `${honey.name} — Bio & Golosità, Cassano d'Adda (MI)`
                : "Gli apiari di Bio & Golosità tra Cassano d'Adda e la Martesana"
            }
            sizes="(min-width: 900px) 45vw, 100vw"
            loading="lazy"
          />
          <figcaption>
            {honey.photo
              ? `Il nostro ${honey.name.toLowerCase()}`
              : 'Gli apiari dove nasce il nostro miele'}
          </figcaption>
        </figure>
      </div>

      <div class="features mt-4">
        {
          origin.map((o) => (
            <div class="feature">
              <div class="feature-icon"><Icons name={o.icon} size={26} /></div>
              <h3>{o.label}</h3>
              <p>{o.value}</p>
            </div>
          ))
        }
      </div>

      {
        honey.videos?.length ? (
          <div class="origin-videos">
            {honey.videos.map((v) => (
              <figure class="origin-video">
                <VideoFigure src={v.src} poster={v.poster} label={v.label} cls={v.cls} />
                {v.caption && <figcaption class="small-note center">{v.caption}</figcaption>}
              </figure>
            ))}
          </div>
        ) : null
      }
    </div>
  </section>

  {/*
    Galleria facoltativa: per ora la usa solo il miele in favo, con la sequenza
    di foto ricavate dal video (in `gallery`, già in ordine d'uso).
  */}
  {
    honey.gallery && (
      <PhotoGallery
        id="foto"
        photos={honey.gallery}
        columns={3}
        eyebrow="in ordine"
        title={honey.galleryTitle ?? 'Le foto'}
        intro={honey.galleryIntro}
      />
    )
  }

  {/*
    Recensioni del prodotto: al massimo tre testi per intero e basta. Il voto
    complessivo non si ripete qui — è già sotto il prezzo del blocco prodotto,
    dove serve a chi decide (nei dati strutturati resta comunque
    nell'`aggregateRating`). Gli stessi testi e le stesse stelle sono nel JSON-LD:
    non si inventa e non si copia niente dalla scheda Google dell'azienda, che è
    un'altra cosa.
  */}
  {
    hasReviews && (
      <section class="section section--soft" id="recensioni" aria-labelledby="recensioni-title">
        <div class="container">
          <div class="section-head center" style="margin-inline:auto;">
            <span class="eyebrow">la parola ai clienti</span>
            <h2 id="recensioni-title">Chi ha provato il nostro {honey.name.toLowerCase()}</h2>
          </div>

          <div class="reviews-grid">
            {reviews.map((r) => (
              <figure class="review">
                <Stars value={r.stars} />
                <blockquote>
                  <p>“{r.text}”</p>
                </blockquote>
                <figcaption>
                  <span class="review-author">{r.name}</span>
                </figcaption>
              </figure>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <Faq
    id="faq-title"
    items={honey.faq}
    eyebrow="domande su questo miele"
    title="Domande frequenti"
  />

  {/*
    Gli altri mieli: card con foto e prezzo, un rimando secco al catalogo completo
    e al confronto tra acacia, millefiori e castagno, nessuna descrizione lunga.
  */}
  <section class="section section--soft" aria-labelledby="other-title">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">scopri anche</span>
        <h2 id="other-title">Gli altri mieli di Bio &amp; Golosità</h2>
        <p>
          Scopri gli altri mieli di <a href="/miele/">nostra produzione</a> o
          confronta{' '}
          <a href="/guide/miele-acacia-millefiori-castagno-differenze/">
            acacia, millefiori e castagno
          </a>.
        </p>
      </div>
      <div class="honey-grid">
        {others.map((h) => <HoneyCard honey={h} />)}
      </div>
    </div>
  </section>

  {/*
    Chiusura compatta: telefono e WhatsApp. Indirizzo, orari, social e mappa
    restano nel footer, dove ci sono già e non vanno ripetuti.
  */}
  <CtaBand
    eyebrow="ordina direttamente dall'apicoltore"
    title={`Vuoi ordinare il ${honey.name.toLowerCase()}?`}
    text="Scrivici per disponibilità, ritiro o consegna."
    whatsappLabel="Scrivi su WhatsApp"
  />
</Base>
