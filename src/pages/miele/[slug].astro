---
import Emoji from '../../components/Emoji.astro';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Picture from '../../components/Picture.astro';
import HoneyCard from '../../components/HoneyCard.astro';
import VideoFigure from '../../components/VideoFigure.astro';
import PhotoGallery from '../../components/PhotoGallery.astro';
import ContactSection from '../../components/ContactSection.astro';
import Icons from '../../components/Icons.astro';
import PhoneCta from '../../components/PhoneCta.astro';
import { site, honeyProducts } from '../../data/site';
import { ogImageFor } from '../../data/og';
import { prezzoNota, prezzoSuRichiesta } from '../../data/bee-products';
import { entryFormat, otherFormats } from '../../lib/price';
import { product, faqPage, localBusiness } from '../../lib/schema';

export function getStaticPaths() {
  // tutte le schede del miele: le cinque varietà e il miele in favo
  return honeyProducts.map((h) => ({
    params: { slug: h.slug },
    props: { honey: h },
  }));
}

const { honey } = Astro.props;
const pathname = `/miele/${honey.slug}/`;
const crumbs = [
  { name: 'I nostri mieli', path: '/miele/' },
  { name: honey.name, path: pathname },
];

const local = "Cassano d'Adda (MI)";

// Il miele in favo è miele con la sua cera: in pagina si parla di "questo favo",
// non di un barattolo (vedi `subject` nei dati).
const subject = honey.subject ?? 'barattolo';

/** Tracciabilità: quello che solo un produttore può documentare. */
const traceability = [
  {
    label: 'Apiario di provenienza',
    value:
      "Apiari di Bio & Golosità tra Cassano d'Adda, la Martesana, la Gera d'Adda, il Parco Adda Nord (area protetta) e la Val Brembana",
  },
  { label: 'Periodo di raccolta', value: honey.harvest.replace(/^Raccolto /, '') },
  {
    label: 'Annata in vendita',
    value: honey.annata ?? "Chiedici qual è il raccolto disponibile in questo periodo",
  },
  {
    label: 'Lavorazione',
    value:
      honey.workNote ?? 'Smielatura a freddo, decantazione, nessuna pastorizzazione',
  },
  {
    label: 'Conservazione consigliata',
    value:
      honey.storageNote ??
      'Barattolo chiuso, al buio, sotto i 14 °C',
  },
];

const guideHref =
  honey.guide?.href ??
  (honey.slug === 'miele-di-acacia'
    ? '/guide/miele-acacia-millefiori-castagno-differenze/'
    : '/guide/perche-il-miele-cristallizza/');
const guideLabel =
  honey.guide?.label ??
  (honey.slug === 'miele-di-acacia'
    ? 'Acacia, millefiori o castagno: le differenze'
    : 'Perché il miele cristallizza (e come riportarlo liquido)');

const heroIntro =
  honey.heroIntro ??
  `${honey.name} 100% italiano e artigianale, di api proprie a ${local}, in provincia di Milano: non pastorizzato, smielato a freddo e raccolto negli apiari tra la Martesana, la Gera d'Adda e il Parco Adda Nord. ${honey.harvest}.`;

// Prezzo ben visibile: il formato d'ingresso in grande, gli altri formati in
// una riga più piccola sotto (stessa idea del "300,00 € (10,00 € al pezzo)").
const priceEntry = entryFormat(honey.priceFormats);
const priceOthers = otherFormats(honey.priceFormats);
---

<Base
  title={honey.title}
  description={honey.description}
  pathname={pathname}
  ogImage={ogImageFor(pathname)}
  type="product"
  crumbs={crumbs}
  jsonLd={[localBusiness(), product(honey, pathname, { category: honey.category ?? 'Miele' }), faqPage(honey.faq)]}
>
  <PageHero
    h1={honey.name}
    intro={heroIntro}
    crumbs={crumbs}
    variant="product"
  />

  <section class="section" style="padding-top: var(--space-3);">
    <div class="container product-grid">
      <div class="product-media">
        <Picture
          base={honey.cardImage ?? honey.image}
          alt={`${honey.name} — Bio & Golosità, Cassano d'Adda (MI)`}
          sizes="(min-width: 900px) 520px, 100vw"
          loading="eager"
          fetchpriority="high"
          objectPosition={honey.imgPos}
        />
      </div>

      <div>
        <p class="product-price">
          {
            priceEntry ? (
              <>
                <span class="price-main">{priceEntry.price}</span>
                <span class="price-unit">({priceEntry.size})</span>
                {priceOthers.length > 0 && (
                  <span class="price-more">
                    {priceOthers.map((f) => `${f.size}: ${f.price}`).join(' · ')}
                  </span>
                )}
              </>
            ) : (
              // prezzo non pubblicato nei dati: niente numeri inventati
              <span class="price-main">{prezzoSuRichiesta}</span>
            )
          }
        </p>
        {!priceEntry && <p class="price-note">{prezzoNota}</p>}

        <p class="bulk-note">
          <Icons name="info" size={18} />
          {/* Il miele in favo ha una nota sua: la disponibilità è poca e solo
              su prenotazione (vedi `note` nei dati). */}
          {honey.note ?? site.bulkNote}
        </p>
        <ul class="chips">
          {honey.characteristics.map((c) => <li>{c}</li>)}
        </ul>

        <div class="contact-cta mt-3">
          <PhoneCta />
          <a class="btn btn-ghost btn-lg" href={site.whatsapp} target="_blank" rel="noopener">
            <Icons name="whatsapp" size={20} />
            Ordina su WhatsApp
          </a>
        </div>

        <p class="mt-3" style="font-size:0.9rem;">
          Ritiro in sede su appuntamento: {site.address.street},{' '}
          {site.address.city} ({site.address.province}). Consegniamo anche a
          domicilio e, in molti casi, la consegna è gratuita. Contattaci per
          verificare se la tua zona è servita.
        </p>
      </div>
    </div>
  </section>

  <section class="section section--soft" aria-labelledby="desc-title">
    <div class="container">
      <div class="prose">
        <span class="eyebrow">il prodotto<Emoji name="honey-pot" /></span>
        <h2 id="desc-title">Il {honey.name.toLowerCase()} di Bio & Golosità</h2>
        <p>{honey.intro}</p>
        <h3>A cosa serve e come usarlo</h3>
        <p>{honey.uses}</p>
        <h3>Scheda tecnica</h3>
        <ul class="specs">
          {honey.specs.map((s) => (
            <li>
              <strong>{s.label}:</strong>
              <span>{s.value}</span>
            </li>
          ))}
        </ul>
        {honey.video && (
          // Video verticale: la colonna stretta gli fa mantenere l'aspetto
          // 9/16 (`.video-item--tall`), senza ritagli.
          <div class="prose-video">
            <VideoFigure
              src={honey.video.src}
              poster={honey.video.poster}
              label={honey.video.label}
              cls={honey.video.cls}
            />
          </div>
        )}
      </div>
    </div>
  </section>

  {/*
    Galleria facoltativa: per ora la usa solo il miele in favo, con la sequenza
    di foto ricavate dal video (in `gallery`, già in ordine d'uso). Foto
    verticali, quindi `g-item--tall` come i telai dei nuclei.
  */}
  {honey.gallery && (
    <PhotoGallery
      id="foto"
      photos={honey.gallery}
      columns={3}
      eyebrow="in ordine"
      title={honey.galleryTitle ?? 'Le foto'}
      intro={honey.galleryIntro}
    />
  )}

  <section class="section" aria-labelledby="trace-title">
    <div class="container split split--photos">
      <div class="split-text">
        <span class="eyebrow">tracciabilità</span>
        <h2 id="trace-title">Da dove arriva questo {subject}</h2>
        <p>
          Ogni {subject} nasce da un apiario preciso e da un periodo di
          fioritura preciso. Sono le informazioni che un miele di produzione
          propria può dare e che una miscela anonima non può replicare.
        </p>
        <ul class="specs">
          {
            traceability.map((t) => (
              <li>
                <strong>{t.label}:</strong>
                <span>{t.value}</span>
              </li>
            ))
          }
        </ul>
        <p class="mt-3" style="font-size:0.92rem;">
          Vuoi vedere come lavoriamo? Nella pagina <a href="/chi-siamo/">chi siamo</a>{' '}
          c'è la storia dell'azienda, e nella guida{' '}
          <a href="/guide/miele-non-pastorizzato-cosa-significa/">miele non pastorizzato: cosa significa davvero</a>{' '}
          spieghiamo cosa cambia rispetto a un miele scaldato.
        </p>
      </div>
      <figure class="split-media">
        <Picture
          base={honey.photo ?? 'sciame_5'}
          alt={
            honey.photo
              ? `${honey.name} — Bio & Golosità, Cassano d'Adda (MI)`
              : "Api di Bio & Golosità in apiario, a Cassano d'Adda"
          }
          sizes="(min-width: 900px) 45vw, 100vw"
          loading="lazy"
        />
        <figcaption>
          {honey.photo ? `Il nostro ${honey.name.toLowerCase()}` : "Gli apiari dove nasce il nostro miele"}
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="section section--soft" aria-labelledby="faq-title">
    <div class="container">
      <div class="section-head center" style="margin-inline:auto;">
        <span class="eyebrow">domande su questo miele</span>
        <h2 id="faq-title">Domande frequenti</h2>
      </div>
      <div class="faq">
        {
          honey.faq.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="other-title">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">scopri anche</span>
        <h2 id="other-title">Gli altri mieli di Bio & Golosità</h2>
        <p>
          Tutti i mieli, con prezzi e formati, sono nella pagina{' '}
          <a href="/miele/">i nostri mieli</a>. Questa è invece la guida
          consigliata: <a href={guideHref}>{guideLabel}</a>.
        </p>
      </div>
      <div class="honey-grid">
        {
          site.honeys
            .filter((h) => h.slug !== honey.slug)
            .slice(0, 3)
            .map((h) => <HoneyCard honey={h} />)
        }
      </div>
      {
        honey.kind !== 'favo' && (
          <p class="mt-3" style="font-size:0.92rem;">
            In stagione prepariamo anche il{' '}
            <a href="/miele/miele-in-favo/">miele in favo</a>: il miele lasciato
            nella sua cera, tagliato dal telaio e mai scaldato.
          </p>
        )
      }
    </div>
  </section>

  <ContactSection />
</Base>
