---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsApp from '../components/WhatsApp.astro';
import Lightbox from '../components/Lightbox.astro';
import { site } from '../data/site';
import { breadcrumbs } from '../lib/schema';
import { imgSrcset, imgUrl } from '../lib/images.js';
import fontCss from '../assets/fonts.css?raw';

interface Props {
  title: string;
  description: string;
  pathname?: string;
  ogImage?: string;
  type?: string;
  jsonLd?: any[];
  /** base dell'immagine hero da precaricare (evita il doppio download su LCP) */
  preloadImage?: string;
  robots?: string;
  /** Percorso di navigazione DOPO la home: Base aggiunge da sé "Home" e
   *  genera il BreadcrumbList JSON-LD. */
  crumbs?: { name: string; path: string }[];
  /** Link WhatsApp con il messaggio della pagina: lo usano il bottone flottante
   *  e il footer. Senza, resta `site.whatsapp` (messaggio generico sul miele). */
  whatsappHref?: string;
}

const {
  title,
  description,
  pathname = '/',
  ogImage = '/og.jpg',
  type = 'website',
  jsonLd = [],
  preloadImage,
  robots = 'index, follow',
  crumbs,
  whatsappHref,
} = Astro.props;

// `.filter(Boolean)`: `product()` torna `null` quando non c'è un'offerta da
// pubblicare (niente prezzo pubblicato), così la pagina non emette un nodo
// Product che Google segnala come item non valido.
const allJsonLd = (
  crumbs ? [...jsonLd, breadcrumbs([{ name: 'Home', path: '/' }, ...crumbs])] : jsonLd
).filter(Boolean);

const canonical = `${site.domain}${pathname}`;
const ogUrl = `${site.domain}${pathname}`;
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta name="theme-color" content="#9a6200" />
    <meta name="robots" content={robots} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content={type} />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={ogUrl} />
    <meta property="og:image" content={`${site.domain}${ogImage}`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${site.domain}${ogImage}`} />

    <style is:inline set:html={fontCss}></style>

    {
      preloadImage && (
        <link
          rel="preload"
          as="image"
          type="image/avif"
          imagesrcset={imgSrcset(preloadImage, 'avif')}
          imagesizes="100vw"
          href={imgUrl(preloadImage, { ext: 'avif' })}
          fetchpriority="high"
        />
      )
    }

    {
      allJsonLd.map((obj) => (
        <script type="application/ld+json" set:html={JSON.stringify(obj)} />
      ))
    }
  </head>

  <body>
    <Header pathname={pathname} />
    <main>
      <slot />
    </main>
    <Footer whatsappHref={whatsappHref} />
    <WhatsApp whatsappHref={whatsappHref} />
    <Lightbox />
  </body>
</html>
